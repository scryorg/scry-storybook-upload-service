{
 "version": 1,
 "doc": "Shared animated-snips contract (spec-writer 2026-10-15). Sync produces `animation` + 4 files; upload validates and stores; dashboard CaptureView returns `animation` + `animationUrl`; MCP prints `expect_ss`; public route serves bytes. Switch: upload/MCP wrangler var ANIMATED_SNIPS == 'on'; dashboard config/flags.json `animated-snips` read with isOnFor. Switch off: upload drops `animation` before validation (today's responses byte-for-byte), dashboard omits the keys, MCP prints today's text, public clip route 404. 400 bodies name fields only, never values. Values here come from fixtures/clip-valid.mp4 and the stills derived from it (fixtures/fixtures.json).",
 "limits": {
  "maxDurationMs": 10000,
  "durationToleranceMs": 100,
  "minDurationMs": 500,
  "maxFps": 12,
  "fpsMeasuredMax": 12.5,
  "fpsToleranceVsDeclared": 0.5,
  "maxLongEdge": 1280,
  "maxBytes": 15728640,
  "aspectToleranceVsOriginal": 0.02,
  "evenDimensions": true,
  "maxMoovBytes": 2097152,
  "codecs": [
   "avc1",
   "avc3"
  ],
  "brands": [
   "isom",
   "iso2",
   "mp41",
   "mp42",
   "avc1"
  ],
  "audio": false,
  "key": "{project}/captures/{captureId}/animation.mp4",
  "contentType": "video/mp4",
  "presignedPutSeconds": 900,
  "signedGetSeconds": 3600,
  "keyFrame": "middle",
  "contactSheet": {
   "cols": 3,
   "rows": 2,
   "frames": 6,
   "frameIndex": "round(i*(n-1)/5), i=0..5",
   "maxWidth": 1280,
   "gutterPx": 2,
   "gutterColour": "white",
   "targetBytes": 71680,
   "mcpInlineMaxBytes": 73500
  }
 },
